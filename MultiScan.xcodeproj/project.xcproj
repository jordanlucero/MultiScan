        {
          "target": "MultiScanShare",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "MultiScanTests", "target-membership": [ "MultiScanTests" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "MultiScan", "MultiScanShare" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MultiScan.app", "id": "B4BCDE0C2DE1209B00BBA2C2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MultiScanTests.xctest", "id": "7A5E02022F8E100000A1B2C3", "type": "wrapper.cfbundle", "index": false },
